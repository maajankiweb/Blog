# ── Site & Domain ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://blog.maajankiwebtech.com

# ── Headless WordPress & WooCommerce API ────────────────────────
NEXT_PUBLIC_WORDPRESS_API_URL=https://cms.maajankiwebtech.com/wp-json/wp/v2
WORDPRESS_API_URL=https://cms.maajankiwebtech.com/wp-json/wp/v2
NEXT_PUBLIC_WORDPRESS_SITE_URL=https://cms.maajankiwebtech.com
WORDPRESS_SITE_URL=https://cms.maajankiwebtech.com

# WooCommerce REST API Credentials
WC_CONSUMER_KEY=ck_your_consumer_key_here
WC_CONSUMER_SECRET=cs_your_consumer_secret_here

# Headless Commerce Secret
WORDPRESS_INTEGRATION_SECRET=your_32_character_secret_here
WORDPRESS_WEBHOOK_SECRET=your_webhook_revalidation_secret_here

# ── Razorpay Payment Gateway ───────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Brevo (Sendinblue) Email Marketing API ─────────────────────
BREVO_API_KEY=your_brevo_api_key_here
BREVO_LIST_ID=2

# ── Resend Transactional Email API ─────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=orders@maajankiwebtech.com

# ── Search Engine Verification ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_token
INDEXNOW_KEY=your_indexnow_key_here
